+  old_max = TCP_WND_MAX(pcb);
+  occupied = old_max - pcb->rcv_wnd + pcb->rcv_wnd_debt;
+  pcb->rcv_wnd_max = LWIP_MIN(max, TCP_WND);
+  new_max = TCP_WND_MAX(pcb);
+  if (occupied >= new_max) {
+    pcb->rcv_wnd_debt = occupied - new_max;
+    pcb->rcv_wnd = 0;
