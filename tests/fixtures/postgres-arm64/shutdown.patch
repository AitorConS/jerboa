diff --git a/src/backend/postmaster/postmaster.c b/src/backend/postmaster/postmaster.c
index bf424df..ee0ea4d 100644
--- a/src/backend/postmaster/postmaster.c
+++ b/src/backend/postmaster/postmaster.c
@@ -579,6 +579,9 @@ PostmasterMain(int argc, char *argv[])
 	pqinitmask();
 	PG_SETMASK(&BlockSig);
 
+	/* Process-directed shutdown signals must reach this thread's handlers. */
+	pqsignal_set_process_target();
+
 	pqsignal_no_restart(SIGHUP, SIGHUP_handler);	/* reread config file and
 													 * have children do same */
 	pqsignal_no_restart(SIGINT, pmdie); /* send SIGTERM and shut down */
diff --git a/src/backend/storage/ipc/ipc.c b/src/backend/storage/ipc/ipc.c
index 82d78ca..41a52e5 100644
--- a/src/backend/storage/ipc/ipc.c
+++ b/src/backend/storage/ipc/ipc.c
@@ -141,6 +141,14 @@ proc_exit(int code)
 
 	elog(DEBUG3, "exit(%d)", code);
 
+	/*
+	 * The postmaster thread owns the server process. Exiting only that thread
+	 * could leave helper threads keeping the process, and a Nanos VM, alive
+	 * after the shutdown checkpoint.
+	 */
+	if (PostmasterPid != 0 && pthread_equal(pthread_self(), PostmasterPid))
+		exit(code);
+
 	pthread_exit((void*)(size_t)code);
 }
 
