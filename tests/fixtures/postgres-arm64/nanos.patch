@@ -37,6 +39,32 @@ volatile session_local uint32 QueryCancelHoldoffCount = 0;
 volatile session_local uint32 CritSectionCount = 0;
 
 session_local pthread_t	MyProcPid;
+static session_local int MyThreadPidValue = 0;
+static uint32 NextThreadPid = 0x40000000;
+
+/*
+ * MyThreadPid --- positive 32-bit identity of the current thread
+ *
+ * MyProcPid is a 64-bit pthread_t, but PgBackendStatus.st_procpid, PGPROC.pid
+ * and pg_backend_pid() are int.  Truncating a pthread_t can yield zero or a
+ * negative value, and pg_stat_activity then hides the thread.  Hand out
+ * unique positive ids instead. They must be resolved to PGPROC.thread_id
+ * under ProcArrayLock before signalling, and must never be recycled.
+ */
+int
+MyThreadPid(void)
+{
+	while (MyThreadPidValue == 0)
+	{
+		uint32		pid = __sync_add_and_fetch(&NextThreadPid, 1);
+
+		if (pid > 0x7fffffff)
+			elog(PANIC, "thread identity space exhausted; restart PostgreSQL");
+		if (pid != getpid())
+			MyThreadPidValue = pid;
+	}
+	return MyThreadPidValue;
+}
 session_local pg_time_t	MyStartTime;
 session_local struct Port *MyProcPort;
 session_local int32		MyCancelKey;
